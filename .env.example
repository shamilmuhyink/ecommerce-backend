# Application
APP_NAME=Ecommerce
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-this-with-a-random-64-character-string-minimum

# CORS (JSON array of allowed origins)
ALLOWED_ORIGINS=["http://localhost:4200"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/ecommerce
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET=skinglow-assets-dev
AWS_SES_SENDER=noreply@skinglow.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# Shipping (Shiprocket)
SHIPROCKET_EMAIL=REPLACE_ME
SHIPROCKET_PASSWORD=REPLACE_ME

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL="http://localhost:4200"